# .env.test — committed template for E2E / Playwright runs.
#
# Pydantic-settings reads `.env` (not `.env.test`) by default, so this file is
# loaded explicitly by `web/tests/e2e/global-setup.ts` and `scripts/setup_e2e.sh`.
# DO NOT rename to `.env` — that would shadow the developer's real config and
# is the exact failure mode that wiped the production login password on
# 2026-05-09 (an automated worktree setup copied the parent `.env` and then
# ran `set-password` against the prod DB).
#
# Rules:
#   - WEB_DATABASE_URL must be a relative path so each worktree / each test run
#     gets its own DB file. Never let it resolve to ~/.tradingagents/web.db.
#   - ENCRYPTION_KEY here is a deterministic placeholder — fine for tests, must
#     never be reused in production.
#   - All upstream LLM keys are intentionally blank so tests cannot accidentally
#     hit paid endpoints. Set WEB_FAKE_RUNNER=true for runner-touching tests.

# === LLM Providers (intentionally blank for tests) ===
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

# === Social Data Vendors (blank for tests) ===
FINNHUB_API_KEY=

# Codex OAuth: ignored when blank.
TRADINGAGENTS_CODEX_OAUTH_AUTH_PATH=

# === Web (test profile) ===
# Relative path — lives next to the working dir, never the home dir.
WEB_DATABASE_URL=sqlite:///./tradingagents_web_e2e.db

# Deterministic Fernet key for tests (44-char url-safe base64). Tests only —
# never reuse this value in production.
ENCRYPTION_KEY=IimxgEbmt3epvaY9I9yEpjSND1bKa_cNYLc4aYhnW30=

# Cookies served over plain HTTP in tests.
WEB_COOKIE_SECURE=false

# Default to fake runner so e2e tests don't burn LLM credits.
WEB_FAKE_RUNNER=true
